{
  "info": {
    "name": "Market Message Processor - Pipeline API",
    "description": "Postman collectie voor de Market Message Processor pipeline API.\n\nVoorbeelden van berichten die alle stappen doorlopen (ACK), en berichten die ergens blijven haken (NACK/FAIL).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "messageUuid",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Valide berichten (ACK pad)",
      "description": "Berichten die succesvol alle 29 stappen doorlopen en een ACK ontvangen.",
      "item": [
        {
          "name": "1a. Submit - Valid AllocationSeries (ACK)",
          "description": "Een volledig geldig AllocationSeries bericht met een bekende EAN code.\nDit bericht doorloopt alle 29 stappen succesvol en resulteert in een ACK.",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 202 Accepted', function() {",
                  "    pm.response.to.have.status(202);",
                  "});",
                  "pm.test('Response bevat messageUuid', function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.messageUuid).to.be.a('string');",
                  "    pm.collectionVariables.set('messageUuid', json.messageUuid);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"xmlContent\": \"<?xml version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"?><AllocationSeries><mRID>a1b2c3d4-e5f6-7890-abcd-ef1234567890</mRID><product><identification>8716867000016</identification></product><startDateTime>2025-01-01T00:00:00Z</startDateTime><endDateTime>2025-01-02T00:00:00Z</endDateTime><resolution>PT15M</resolution><position>1</position><quantity>100.000</quantity><position>2</position><quantity>200.000</quantity></AllocationSeries>\",\n  \"manualEntry\": false,\n  \"eanCode\": \"871686700012345678\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/messages",
              "host": ["{{baseUrl}}"],
              "path": ["api", "messages"]
            }
          }
        },
        {
          "name": "1b. Submit - Valid AggregatedAllocation (ACK)",
          "description": "Een geldig geaggregeerd allocatiebericht met de correcte allocatiegroep (PRF).\nResulteert in ACK.",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 202 Accepted', function() {",
                  "    pm.response.to.have.status(202);",
                  "});",
                  "pm.test('Response bevat messageUuid', function() {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('messageUuid', json.messageUuid);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"xmlContent\": \"<?xml version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"?><AggregatedAllocation><mRID>b2c3d4e5-f6a7-8901-bcde-f12345678901</mRID><product><identification>023</identification></product><allocatiegroep>PRF</allocatiegroep><startDateTime>2025-01-01T00:00:00Z</startDateTime><endDateTime>2025-01-02T00:00:00Z</endDateTime><resolution>PT15M</resolution><position>1</position><quantity>500.000</quantity></AggregatedAllocation>\",\n  \"manualEntry\": false,\n  \"eanCode\": \"871686700012345678\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/messages",
              "host": ["{{baseUrl}}"],
              "path": ["api", "messages"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Ongeldige berichten (NACK/FAIL pad)",
      "description": "Berichten die ergens in de pipeline blijven haken.",
      "item": [
        {
          "name": "2a. FAIL bij Step 1A - Leeg bericht",
          "description": "Bericht zonder XML content.\nFAALT bij stap 1A (Ontvangen marktbericht) omdat xmlContent leeg is.\nAlle volgende stappen worden overgeslagen.",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 202 Accepted', function() {",
                  "    pm.response.to.have.status(202);",
                  "});",
                  "pm.test('Response bevat messageUuid', function() {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('messageUuid', json.messageUuid);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"xmlContent\": \"\",\n  \"manualEntry\": false,\n  \"eanCode\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/messages",
              "host": ["{{baseUrl}}"],
              "path": ["api", "messages"]
            }
          }
        },
        {
          "name": "2b. FAIL bij Step 1C - Ongeldige XML",
          "description": "Bericht met kapotte/ongeldige XML.\nHaalt stap 1A en 1B, maar FAALT bij stap 1C (Technische validatie) omdat de XML niet parseerbaar is.\nAlle stappen na 1C worden overgeslagen.",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 202 Accepted', function() {",
                  "    pm.response.to.have.status(202);",
                  "});",
                  "pm.test('Response bevat messageUuid', function() {",
                  "    var json = pm.response.json();",
