              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"xmlContent\": \"<?xml version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"?><AllocationSeries><mRID>GEEN-GELDIG-UUID-FORMAAT</mRID><product><identification>8716867000016</identification></product><startDateTime>2025-01-01T00:00:00Z</startDateTime><endDateTime>2025-01-02T00:00:00Z</endDateTime><resolution>PT15M</resolution><position>1</position><quantity>100.000</quantity></AllocationSeries>\",\n  \"manualEntry\": false,\n  \"eanCode\": \"871686700012345678\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/messages",
              "host": ["{{baseUrl}}"],
              "path": ["api", "messages"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Status & Beheer",
      "description": "Endpoints om de status van berichten te bekijken en te beheren.",
      "item": [
        {
          "name": "3a. GET - Status van laatste bericht",
          "description": "Haal de volledige status op van het laatst ingediende bericht.\nToont alle 29 stappen met hun status (COMPLETED, SKIPPED, FAILED, PENDING).",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response bevat steps', function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.steps).to.be.an('array');",
                  "    pm.expect(json.steps.length).to.equal(29);",
                  "});",
                  "pm.test('Steps zijn in volgorde', function() {",
                  "    var json = pm.response.json();",
                  "    for (var i = 0; i < json.steps.length; i++) {",
                  "        pm.expect(json.steps[i].stepOrder).to.equal(i + 1);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/messages/{{messageUuid}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "messages", "{{messageUuid}}"]
            }
          }
        },
        {
          "name": "3b. GET - Alle berichten (overzicht)",
          "description": "Haal een overzicht van alle verwerkte berichten op.",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response is een array', function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/messages",
              "host": ["{{baseUrl}}"],
              "path": ["api", "messages"]
            }
          }
        },
        {
          "name": "3c. GET - Berichten op status (COMPLETED)",
          "description": "Haal alle berichten op met status COMPLETED.",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/messages/status/COMPLETED",
              "host": ["{{baseUrl}}"],
              "path": ["api", "messages", "status", "COMPLETED"]
            }
          }
        },
        {
          "name": "3d. GET - Berichten op status (FAILED)",
          "description": "Haal alle berichten op met status FAILED.",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/messages/status/FAILED",
              "host": ["{{baseUrl}}"],
              "path": ["api", "messages", "status", "FAILED"]
            }
          }
        },
        {
          "name": "3e. POST - Herverwerk een gefaald bericht",
          "description": "Herverwerk een bericht dat eerder is gefaald of geparkeerd.\nGebruik de messageUuid van een FAILED of PARKED bericht.\nDe pipeline wordt opnieuw doorlopen vanaf stap 1A.",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response bevat REPROCESSING status', function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.equal('REPROCESSING');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/messages/{{messageUuid}}/reprocess",
              "host": ["{{baseUrl}}"],
              "path": ["api", "messages", "{{messageUuid}}", "reprocess"]
            }
          }
        },
        {
          "name": "3f. POST - Submit raw XML",
          "description": "Dien ruwe XML direct in via het /xml endpoint.\nHandig voor integraties die direct XML sturen.",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/xml"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<AllocationSeries>\n    <mRID>f6a7b8c9-d0e1-2345-f012-3456789abcde</mRID>\n    <product>\n        <identification>8716867000016</identification>\n    </product>\n    <startDateTime>2025-01-01T00:00:00Z</startDateTime>\n    <endDateTime>2025-01-02T00:00:00Z</endDateTime>\n    <resolution>PT15M</resolution>\n    <position>1</position>\n    <quantity>250.000</quantity>\n</AllocationSeries>"
            },
            "url": {
              "raw": "{{baseUrl}}/api/messages/xml",
              "host": ["{{baseUrl}}"],
              "path": ["api", "messages", "xml"]
            }
          }
        }
      ]
