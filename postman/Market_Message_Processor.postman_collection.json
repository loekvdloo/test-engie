                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"xmlContent\": \"<dit is geen geldige xml><zonder sluittag\",\n  \"manualEntry\": false,\n  \"eanCode\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/messages",
              "host": ["{{baseUrl}}"],
              "path": ["api", "messages"]
            }
          }
        },
        {
          "name": "2c. FAIL bij Step 1E - Onbekend berichttype",
          "description": "Bericht met geldige XML maar een onbekend root element.\nHaalt stap 1A t/m 1D, maar FAALT bij stap 1E (Identificatie berichttype).\nAlle stappen na 1E worden overgeslagen.",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 202 Accepted', function() {",
                  "    pm.response.to.have.status(202);",
                  "});",
                  "pm.test('Response bevat messageUuid', function() {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('messageUuid', json.messageUuid);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"xmlContent\": \"<?xml version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"?><OnbekendBerichttype><mRID>c3d4e5f6-a7b8-9012-cdef-123456789012</mRID><data>test</data></OnbekendBerichttype>\",\n  \"manualEntry\": false,\n  \"eanCode\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/messages",
              "host": ["{{baseUrl}}"],
              "path": ["api", "messages"]
            }
          }
        },
        {
          "name": "2d. NACK bij Step 3A - Ongeldige EAN",
          "description": "Bericht met een EAN code die niet in het BRP register staat.\nDoorloopt fase 1 en 2 succesvol, maar krijgt bij stap 3A een BRP001 validatiefout.\nResulteert in NACK bij fase 4.",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 202 Accepted', function() {",
                  "    pm.response.to.have.status(202);",
                  "});",
                  "pm.test('Response bevat messageUuid', function() {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('messageUuid', json.messageUuid);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"xmlContent\": \"<?xml version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"?><AllocationSeries><mRID>d4e5f6a7-b8c9-0123-def0-123456789abc</mRID><product><identification>8716867000016</identification></product><startDateTime>2025-01-01T00:00:00Z</startDateTime><endDateTime>2025-01-02T00:00:00Z</endDateTime><resolution>PT15M</resolution><position>1</position><quantity>50.000</quantity></AllocationSeries>\",\n  \"manualEntry\": false,\n  \"eanCode\": \"999999999999999999\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/messages",
              "host": ["{{baseUrl}}"],
              "path": ["api", "messages"]
            }
          }
        },
        {
          "name": "2e. NACK bij Step 3C - Verplichte velden ontbreken",
          "description": "Bericht waar verplichte velden (product, startDateTime, endDateTime, resolution) ontbreken.\nDoorloopt fase 1 en 2 succesvol, maar krijgt bij stap 3C meerdere VLD001 validatiefouten.\nResulteert in NACK bij fase 4.",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 202 Accepted', function() {",
                  "    pm.response.to.have.status(202);",
                  "});",
                  "pm.test('Response bevat messageUuid', function() {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('messageUuid', json.messageUuid);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"xmlContent\": \"<?xml version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"?><AllocationSeries><mRID>e5f6a7b8-c9d0-1234-ef01-23456789abcd</mRID><data>minimaal bericht zonder verplichte velden</data></AllocationSeries>\",\n  \"manualEntry\": false,\n  \"eanCode\": \"871686700012345678\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/messages",
              "host": ["{{baseUrl}}"],
              "path": ["api", "messages"]
            }
          }
        },
        {
          "name": "2f. NACK bij Step 3G - Ongeldig mRID UUID formaat",
          "description": "Bericht met een mRID die niet het UUID formaat heeft.\nDoorloopt fase 1 t/m 3F, maar krijgt bij stap 3G een HBR001 validatiefout.\nResulteert in NACK bij fase 4.",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 202 Accepted', function() {",
                  "    pm.response.to.have.status(202);",
                  "});",
                  "pm.test('Response bevat messageUuid', function() {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('messageUuid', json.messageUuid);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
